{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "imagePullSecrets", "replicaCount", "service", "upstream", "mockUpstream", "resources", "networkPolicy", "protectedValues", "policy"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
        }
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 20},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "upstream": {"type": "string", "pattern": "^https?://", "minLength": 8},
    "mockUpstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "protectedValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "key"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "strict_config", "default_action", "rules", "rule_overrides", "scan", "expose_block_detail", "custom_regex_timeout_ms", "custom_rules"],
      "properties": {
        "version": {"const": 1},
        "strict_config": {"const": true},
        "default_action": {"$ref": "#/definitions/action"},
        "rules": {
          "type": "object",
          "required": ["rrn", "card", "secret"],
          "additionalProperties": {"$ref": "#/definitions/action"}
        },
        "rule_overrides": {
          "type": "object",
          "additionalProperties": {"$ref": "#/definitions/action"}
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request", "response", "max_body_bytes", "oversize_action", "unscannable_action", "sse_mode"],
          "properties": {
            "request": {"type": "boolean"},
            "response": {"type": "boolean"},
            "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
            "oversize_action": {"enum": ["block", "alert"]},
            "unscannable_action": {"enum": ["block", "alert"]},
            "sse_mode": {"enum": ["buffer", "event"]}
          }
        },
        "expose_block_detail": {"type": "boolean"},
        "custom_regex_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 100},
        "custom_rules": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/definitions/customRule"}
        }
      }
    }
  },
  "definitions": {
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "pattern": "^[0-9]+(?:m|\\.[0-9]+)?$"},
        "memory": {"type": "string", "pattern": "^[0-9]+(?:Ki|Mi|Gi|Ti|Pi|Ei)$"}
      }
    },
    "action": {"enum": ["redact", "block", "alert"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directions": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {"enum": ["request", "request-path", "request-query", "response"]}
        },
        "methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z]{3,10}$"}
        },
        "path_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/", "maxLength": 256}
        }
      }
    },
    "literalMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values"],
      "properties": {
        "type": {"const": "literal"},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 512}
        },
        "ignore_case": {"type": "boolean"},
        "whole_word": {"type": "boolean"}
      }
    },
    "regexMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pattern"],
      "properties": {
        "type": {"const": "regex"},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 512},
        "ignore_case": {"type": "boolean"}
      }
    },
    "contextualMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "groups", "window_chars"],
      "properties": {
        "type": {"const": "contextual"},
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 3, "maxLength": 128}
          }
        },
        "window_chars": {"type": "integer", "minimum": 16, "maximum": 1024},
        "ignore_case": {"type": "boolean"}
      }
    },
    "customRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "matcher"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "description": {"type": "string", "maxLength": 200},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
        "action": {"$ref": "#/definitions/action"},
        "scope": {"$ref": "#/definitions/scope"},
        "matcher": {
          "oneOf": [
            {"$ref": "#/definitions/literalMatcher"},
            {"$ref": "#/definitions/regexMatcher"},
            {"$ref": "#/definitions/contextualMatcher"}
          ]
        }
      }
    }
  }
}
